# Environment for the old Python bot during the coexistence period.
# Use the same values as the existing twitch/osu/Mongo deployment.
MONGODB_URL=mongodb://127.0.0.1:27017
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TMI_TOKEN=
BOT_NICK=
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
SENTRY_DSN=
LOG_LEVEL=INFO
ENVIRONMENT=production

# New authoritative API and migration notice.
# Use http://ronnia:4343 if the old bot runs in a container on the Compose network.
RONNIA_API_URL=http://127.0.0.1:4343
# Must exactly equal INTERNAL_API_TOKEN from the new service's .env. Keep secret.
RONNIA_INTERNAL_TOKEN=
RONNIA_MIGRATION_URL=http://localhost:3000
RONNIA_LEGACY_MODE=true
DRY_RUN=false
