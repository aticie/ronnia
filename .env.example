# Copy to .env for Docker Compose. For local runs, export these variables.
# Never put a real .env or Mongo export in a container build context.
DATABASE_PATH=/data/ronnia.sqlite3
BIND_IP=0.0.0.0
BIND_PORT=8080
# Shared private network created by backend Compose; match in ronnia-web.
RONNIA_NETWORK=ronnia
PUBLIC_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8080/oauth2/twitch-redirect
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=http://localhost:8080/oauth2/osu-redirect
# 64 hex chars from `ronnia generate-token-key`. Required when the bot is enabled.
# Authorize the bot account separately with `ronnia --database ... authorize-bot --login NAME`.
TWITCH_TOKEN_KEY=
TWITCH_EVENTSUB_URL=wss://eventsub.wss.twitch.tv/ws?keepalive_timeout_seconds=30
BOT_ENABLED=true
DRY_RUN=false
DEBUG_MODE=false
# Coexistence period: show the dashboard banner and enable the legacy bridge.
MIGRATION_ACTIVE=false
# RFC 3339; displayed by the dashboard banner. Does not stop the legacy bot automatically.
MIGRATION_CUTOFF_AT=2026-12-04T00:00:00Z
# Delay before the new bot claims a channel after Twitch consent.
MIGRATION_GRANT_GRACE_SECS=10
# Strong shared secret for the old bot's /internal/legacy API requests. Never expose to browsers.
INTERNAL_API_TOKEN=
RECONCILE_INTERVAL_SECS=600
EVENTSUB_CHANNELS_PER_SHARD=100
EVENTSUB_MAX_SHARDS=16
REQUEST_WORKERS=8
REQUEST_QUEUE_CAPACITY=128
HTTP_TIMEOUT_SECS=20
SESSION_TTL_SECS=2592000
OAUTH_TTL_SECS=600
LOG_LEVEL=info
# Optional; no full-rate tracing/profiling enabled.
SENTRY_DSN=
